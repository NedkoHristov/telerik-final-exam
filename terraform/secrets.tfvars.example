# Example secrets file - Copy to secrets.tfvars and fill in your actual values
# WARNING: Never commit secrets.tfvars to version control!

# SSH public key for the terraform user
# Example: "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ... user@example.com"
ssh_public_key = "your-ssh-public-key-here"

# New Relic license key for infrastructure monitoring
# Get this from: https://one.newrelic.com/launcher/api-keys-ui.api-keys-launcher
# Example: "eu01xxaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXNRAL"
newrelic_license_key = "your-newrelic-license-key-here"
